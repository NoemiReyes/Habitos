# Copia este archivo a ".env" y rellena tus datos.
# NUNCA subas el archivo .env a internet: contiene tus claves secretas.

# --- Telegram ---
# Habla con @BotFather en Telegram, crea un bot y pega aquí el token.
TELEGRAM_TOKEN=

# --- Notion ---
# Crea una integración en https://www.notion.so/my-integrations
# y pega aquí el "Internal Integration Secret".
NOTION_TOKEN=
# Lo obtienes al correr:  python setup_notion.py <id_de_tu_pagina>
NOTION_DATABASE_ID=

# --- Claude (Anthropic) ---
# Tu clave de API de https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Opcionales (tienen valores por defecto sensatos) ---
# Modelo del coach: claude-opus-5 (mejor) | claude-sonnet-5 | claude-haiku-4-5 (más barato)
COACH_MODEL=claude-opus-5
# Horas de recordatorio (24h, hora del equipo donde corre el bot)
HORA_MANANA=07:00
HORA_NOCHE=21:00
# Tus metas
META_LEVANTARSE=07:00
META_EJERCICIO_MIN=20
META_CLIENTES=3

# --- Apple Watch (opcional) ---
# Inventa una palabra secreta. Si la defines, el bot abre un "buzón" para
# recibir datos de tu iPhone (Atajos de Apple). Déjala vacía si no lo usas.
# La MISMA palabra va en el Atajo de tu iPhone. Ver README (sección Apple Watch).
WEBHOOK_TOKEN=
# Puerto del buzón (en Railway/Render se usa PORT automáticamente).
WEBHOOK_PORT=8080
